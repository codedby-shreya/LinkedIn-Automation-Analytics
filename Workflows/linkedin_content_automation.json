    {
      "parameters": {
        "promptType": "define",
        "text": "=Write one engaging and professional LinkedIn post about:\n\n{{ $json.topic }}\n\nStay strictly focused on this topic.\n\nRequirements:\n- Start with a strong hook.\n- Explain the concept in beginner-friendly language.\n- Explain how it works step by step.\n- Include 2-3 practical examples.\n- Use a professional, conversational tone.\n- End with an engaging question.\n- Add 4-5 relevant hashtags.\n- Return only the final LinkedIn post.",
        "options": {
          "systemMessage": "You are a LinkedIn content writer. Writing requirements:\n- Start with an interesting hook.\n- Use beginner-friendly language.\n- Include practical examples.\n- Use short paragraphs and bullet points.\n- End with an engaging question.\n- Include 4-5 relevant hashtags.\n- Avoid unsupported statistics.\n- Make the post sound natural and human.\n\nReturn only the LinkedIn post."
        }
