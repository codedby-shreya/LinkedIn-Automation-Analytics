    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nconst items = $input.all();\n\nreturn items.map(item => {\n  const base64Image = item.json.result.image;\n  const imageBuffer = Buffer.from(base64Image, 'base64');\n\n  item.binary = item.binary || {};\n\n  item.binary.image = {\n    data: imageBuffer.toString('base64'),\n    mimeType: 'image/jpeg',\n    fileName: 'linkedin-post-image.jpg',\n    fileExtension: 'jpg'\n  };\n\n  item.json.generated_post = $('AI Agent').first().json.output;\n\n  return item;\n});"
      },
