    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nconst items = $input.all();\n\nconst source = $('Code in JavaScript').first();\n\nreturn items.map(item => {\n  item.binary = item.binary || {};\n\n  item.binary.image = source.binary.image;\n\n  item.json.generated_post =\n    source.json.generated_post ||\n    $('AI Agent').first().json.output;\n\n  return item;\n});"
